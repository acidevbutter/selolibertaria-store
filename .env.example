ENABLE_EXPERIMENTAL_COREPACK=1

NEXT_PUBLIC_URL=http://localhost:3000

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
ENABLE_STRIPE_TAX=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=products
RUN_PRODUCT_IMAGE_MIGRATION=false

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=yournextstore
# Se estiver usando docker-compose, pode usar o hostname do serviço:
# MONGODB_URI=mongodb://mongo:27017

# JWT secret (mínimo 32 chars)
JWT_SECRET=dev_super_secret_change_me_please_123456

DOCKER=

NEXT_PUBLIC_LANGUAGE=pt-BR

# OPTIONAL:
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

EMAIL=
PASSWORD=

# Admin seed
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=Administrador Ratoeira77
ADMIN_PHONE=+5511999999999
ADMIN_VERIFIED=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@local.test

# Optional fallback provider when SMTP fails.
# Brevo free plan includes transactional sending and can be enabled
# without changing application code.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Melhor Envio
MELHOR_ENVIO_ENABLED=false
MELHOR_ENVIO_ENVIRONMENT=sandbox
MELHOR_ENVIO_BASE_URL=
MELHOR_ENVIO_ACCESS_TOKEN=
MELHOR_ENVIO_ORIGIN_POSTAL_CODE=
MELHOR_ENVIO_DEFAULT_WEIGHT_GRAMS=300
MELHOR_ENVIO_DEFAULT_LENGTH_CM=20
MELHOR_ENVIO_DEFAULT_WIDTH_CM=15
MELHOR_ENVIO_DEFAULT_HEIGHT_CM=10
MELHOR_ENVIO_USER_AGENT=
MELHOR_ENVIO_CONTACT_EMAIL=
