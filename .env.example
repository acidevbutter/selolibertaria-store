ENABLE_EXPERIMENTAL_COREPACK=1

NEXT_PUBLIC_URL=http://localhost:3000

CATALOG_CURRENCY=BRL
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# FastAPI backend (selolibertaria/backend), reachable on devbutter_shared as
# selolibertaria-backend:8000 when both docker-compose projects are up.
FASTAPI_API_URL=http://selolibertaria-backend:8000
# OAuth state secret (mínimo 32 chars)
OAUTH_STATE_SECRET=dev_oauth_state_secret_change_me_please_123456
FASTAPI_INTERNAL_API_KEY=replace-with-the-fastapi-internal-key

# backend/ (FastAPI + PostgreSQL, git submodule) -- see backend/.env.example
# for the service's own env vars. This is only needed here once Next.js
# routes start proxying to it.
BACKEND_DATABASE_URL=postgresql+asyncpg://selolibertaria:selolibertaria@shared-postgres:5432/selolibertaria_backend

DOCKER=

NEXT_PUBLIC_LANGUAGE=pt-BR

# OPTIONAL:
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

EMAIL=
PASSWORD=

# Admin seed
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=Administrador Ratoeira77
ADMIN_PHONE=+5511999999999
ADMIN_VERIFIED=true


# Melhor Envio

# Maintenance mode: when "true", every public route redirects to /login and
# only admin credentials can sign in. Default (off) if unset.
MAINTENANCE_MODE=false

# Datadog RUM
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=us5.datadoghq.com
NEXT_PUBLIC_DD_ENV=development
NEXT_PUBLIC_DD_SERVICE=selolibertaria
NEXT_PUBLIC_DD_VERSION=1.12.0
NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE=100
NEXT_PUBLIC_DD_SESSION_REPLAY_SAMPLE_RATE=20
NEXT_PUBLIC_DD_DEFAULT_PRIVACY_LEVEL=mask-user-input
