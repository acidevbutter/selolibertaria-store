ENABLE_EXPERIMENTAL_COREPACK=1

NEXT_PUBLIC_URL=http://localhost:3000

CATALOG_CURRENCY=BRL
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_RECONCILIATION_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=products

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=yournextstore
# Se estiver usando docker-compose, pode usar o hostname do serviço:
# MONGODB_URI=mongodb://mongo:27017

# JWT secret (mínimo 32 chars)
JWT_SECRET=dev_super_secret_change_me_please_123456

# backend/ (FastAPI + PostgreSQL, git submodule) -- see backend/.env.example
# for the service's own env vars. This is only needed here once Next.js
# routes start proxying to it.
BACKEND_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/selolibertaria_backend

DOCKER=

NEXT_PUBLIC_LANGUAGE=pt-BR

# OPTIONAL:
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

EMAIL=
PASSWORD=

# Admin seed
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=Administrador Ratoeira77
ADMIN_PHONE=+5511999999999
ADMIN_VERIFIED=true

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@local.test

# Optional fallback provider when SMTP fails.
# Brevo free plan includes transactional sending and can be enabled
# without changing application code.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Melhor Envio
MELHOR_ENVIO_ACCESS_TOKEN=

# Maintenance mode: when "true", every public route redirects to /login and
# only admin credentials can sign in. Default (off) if unset.
MAINTENANCE_MODE=false

# Datadog RUM
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=us5.datadoghq.com
NEXT_PUBLIC_DD_ENV=development
NEXT_PUBLIC_DD_SERVICE=selolibertaria
NEXT_PUBLIC_DD_VERSION=1.12.0
NEXT_PUBLIC_DD_SESSION_SAMPLE_RATE=100
NEXT_PUBLIC_DD_SESSION_REPLAY_SAMPLE_RATE=20
NEXT_PUBLIC_DD_DEFAULT_PRIVACY_LEVEL=mask-user-input
