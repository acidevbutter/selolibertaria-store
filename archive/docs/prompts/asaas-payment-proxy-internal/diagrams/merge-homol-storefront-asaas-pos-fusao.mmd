    subgraph SELO["selolibertaria/backend"]
        direction TB
        CS["checkout_service.py\nAsaasCheckoutService\n(reconciliacao em Payment,\n401 -> reactive rotation)"]
        CLI["client.py\nAsaasClient\n(delegação pura -- sem HTTP proprio)"]
        PROXY["proxy_client.py\nAsaasProxyClient\nmTLS para asaas_payment"]
        MTLS["mtls.py\nmtls_options()\n(cert/key/ca compartilhado)"]
        MIRROR["mirror_client.py\nAsaasMirrorClient\n(double-write, condicionado a\nASAAS_PAYMENT_BASE_URL)"]
        WEBHOOK["webhook_jobs.py\n(gate por asaas_payment_base_url)"]
        CRED["credential_store.py\nAsaasCredentialStore\n(mantido -- so bookkeeping local:\nmark_verified / mark_pending_rotation)"]
        ROT["rotation_service.py\nAsaasRotationService\n(401 -> pede rotacao ao devbutter_backend)"]

        CS --> CLI --> PROXY --> MTLS
        CS -.-> CRED
        CS --> ROT --> CRED
        MIRROR --> MTLS
        WEBHOOK -.->|"so roda com proxy configurado"| MIRROR
    end

    PROXY -->|"mTLS cert=sales-api.crt\nverify=ca.crt"| ASAASPAY["asaas_payment\n(cofre + proxy, fora deste repo)"]
    ASAASPAY --> ASAAS["Asaas API"]

