        VAULT["vault_client.py\nAsaasPaymentVaultClient\n(buscava ciphertext Fernet e\ndecriptava em memoria)"]
        MOCK["client.py: modo mock\n(_mock_digest, _MOCK_INITIAL_STATUS)"]
        FLAGS["config.py:\nasaas_encrypted_vault_enabled\nasaas_client_mode\nasaas_base_url\nasaas_request_timeout_seconds"]
        TESTV["tests/test_asaas_vault_and_mirror.py"]
    end

    CLI -.->|"ate este merge, _resolve_api_key()\nchamava isto quando\nASAAS_ENCRYPTED_VAULT_ENABLED=true"| VAULT

    subgraph FIX["bug corrigido durante a fusao"]
        direction TB
        GAP["proxy_client.py so tinha\ncreate_customer/create_charge/get_charge\n+ invoices -- faltavam\nfind_charge/cancel_charge/refund_charge"]
        IMPACT["app/orders/service.py chama\ncancel_charge e refund_charge;\nsem eles, cancelamento/estorno\nquebrava silenciosamente"]
        ADDED["find_charge, cancel_charge e\nrefund_charge adicionados a\nAsaasProxyClient nesta fusao"]
