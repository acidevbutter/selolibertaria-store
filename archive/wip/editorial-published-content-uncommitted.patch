+/**
+ * A draft may legitimately be an empty document. In that case, opening the
+ * editor must not hide the version that is currently published.
+ */
+export function selectInitialEditorialDocument(record: EditorialBlocksRecord | null) {
+	if (record?.draftDoc && record.draftDoc.length > 0) return record.draftDoc;
+	return record?.publishedDoc ?? record?.draftDoc ?? null;
+}
