{
	"$schema": "https://json.schemastore.org/package",
	"name": "selolibertaria",
	"version": "1.12.0",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"packageManager": "yarn@1.22.22",
	"scripts": {
		"dev": "next dev --webpack -p 3001",
		"build": "node scripts/build.mjs",
		"start": "next start",
		"lint": "biome check --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "sh -c 'if [ -x node_modules/.bin/husky ]; then husky; else echo \"Skipping husky install: dependency not available in this environment.\"; fi'",
		"docker:build": "docker build -t selolibertaria .",
		"docker:run": "docker run -d -p 3000:3000 selolibertaria"
	},
	"dependencies": {
