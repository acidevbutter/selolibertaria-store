		"@vercel/analytics": "1.5.0",
		"@vercel/edge-config": "1.4.0",
		"@vercel/speed-insights": "1.2.0",
		"apexcharts": "5.3.5",
		"bcryptjs": "3.0.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"framer-motion": "12.23.24",
		"intl-messageformat": "10.7.16",
		"jose": "6.1.0",
		"lucide-react": "0.542.0",
